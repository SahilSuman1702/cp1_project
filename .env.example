# Set these as Environment Variables on Render (Dashboard -> your service -> Environment)

# Long random string (used to sign login sessions and email codes)
SECRET_KEY=change-this-to-a-long-random-string

# --- Email sending (Brevo HTTP API - works on Render free plan) ---
BREVO_API_KEY=your-brevo-api-key
MAIL_FROM=you@example.com          # must be a sender you verified inside Brevo
MAIL_FROM_NAME=DirectLine

# --- Optional: SMTP instead of Brevo (blocked on Render free plan, works on paid/local) ---
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=you@gmail.com
# SMTP_PASS=your-app-password

# --- Local testing only: prints the code in the console instead of emailing it ---
# EMAIL_DEV_MODE=1
